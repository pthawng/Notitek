# Copy to .env (never commit .env). Values match deploy/compose.yaml.
NOTITEK_ENV=local
NOTITEK_LOG_LEVEL=debug
NOTITEK_HTTP_ADDR=:8080
NOTITEK_ADMIN_ADDR=:9090
NOTITEK_SHUTDOWN_TIMEOUT=15s

NOTITEK_POSTGRES_DSN=postgres://notitek:notitek@localhost:5432/notitek?sslmode=disable
NOTITEK_POSTGRES_MAX_CONNS=10

NOTITEK_RABBITMQ_URL=amqp://notitek:notitek@localhost:5672/notitek

NOTITEK_REDIS_ADDR=localhost:6379
NOTITEK_REDIS_PASSWORD=
NOTITEK_REDIS_DB=0
