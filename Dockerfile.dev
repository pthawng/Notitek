# syntax=docker/dockerfile:1
# Development image: Go toolchain + air (hot reload) + goose (migrations).
# Source is bind-mounted at runtime; nothing from the repo is copied in.
# Production images are built from ./Dockerfile.

FROM golang:1.26-alpine

ARG AIR_VERSION=v1.67.4
ARG GOOSE_VERSION=v3.28.0

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go install github.com/air-verse/air@${AIR_VERSION} && \
    go install github.com/pressly/goose/v3/cmd/goose@${GOOSE_VERSION}

# The alpine image has no git; stamping VCS info from the mounted .git would
# fail every build.
ENV CGO_ENABLED=0 \
    GOFLAGS=-buildvcs=false

WORKDIR /src
